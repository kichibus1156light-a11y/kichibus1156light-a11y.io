:root{
  --bg:#01030a;
  --panel:rgba(3,8,18,.78);
  --panel-strong:rgba(3,8,18,.92);
  --line:rgba(145,190,220,.24);
  --line-strong:rgba(145,190,220,.42);
  --text:#dbe8f2;
  --muted:#7890a3;
  --dim:#506575;
  --accent:#9bc7e3;
  --accent-2:#cfe9fa;
  --warn:#d8a86b;
  --danger:#df6d64;
  --safe-b:env(safe-area-inset-bottom,0px);
  --safe-t:env(safe-area-inset-top,0px);
}

*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

html,
body{
  width:100%;
  height:100%;
  margin:0;
  padding:0;
  overflow:hidden;
  background:var(--bg);
  color:var(--text);
  font-family:
    "Noto Sans JP",
    "Helvetica Neue",
    Arial,
    sans-serif;
  -webkit-text-size-adjust:100%;
  text-size-adjust:100%;
}

body{
  position:relative;
  user-select:none;
  -webkit-user-select:none;
}

button{
  font:inherit;
  color:inherit;
}

button:focus{
  outline:none;
}

button:focus-visible{
  outline:1px solid var(--accent);
  outline-offset:2px;
}

/* =========================================================
   STAGE
   ========================================================= */

#stage{
  position:fixed;
  inset:0;
  overflow:hidden;
  background:#01030a;
}

#stage-canvas{
  position:absolute;
  inset:0;
  display:block;
  width:100%;
  height:100%;
}

#stage-vignette{
  position:absolute;
  inset:0;
  pointer-events:none;
  background:
    radial-gradient(
      ellipse at center,
      transparent 45%,
      rgba(0,0,0,.22) 72%,
      rgba(0,0,0,.62) 100%
    );
  z-index:5;
}

#stage-scan{
  position:absolute;
  inset:0;
  pointer-events:none;
  z-index:6;
  opacity:.10;
  background:
    repeating-linear-gradient(
      to bottom,
      rgba(255,255,255,.035) 0,
      rgba(255,255,255,.035) 1px,
      transparent 1px,
      transparent 4px
    );
}

#flash-overlay{
  position:absolute;
  inset:0;
  background:#fff;
  opacity:0;
  pointer-events:none;
  z-index:100;
}

/* =========================================================
   COMMON PANEL
   ========================================================= */

.hud-panel{
  position:absolute;
  background:var(--panel);
  border:1px solid var(--line);
  box-shadow:
    0 0 20px rgba(0,0,0,.25),
    inset 0 0 18px rgba(120,170,210,.025);
  backdrop-filter:blur(7px);
  -webkit-backdrop-filter:blur(7px);
}

.mono{
  font-family:
    "Roboto Mono",
    "SFMono-Regular",
    Consolas,
    monospace;
}

/* =========================================================
   TOP HUD
   ========================================================= */

#hud-top{
  position:absolute;
  top:0;
  left:0;
  right:0;
  z-index:20;
  padding:
    calc(14px + var(--safe-t))
    18px
    0;
  pointer-events:none;
}

#hud-top-inner{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:20px;
}

#project-label{
  display:flex;
  flex-direction:column;
  gap:3px;
}

#project-label .p-main{
  font-size:10px;
  font-weight:500;
  letter-spacing:.22em;
  color:var(--accent);
  text-transform:uppercase;
}

#project-label .p-sub{
  font-size:8px;
  letter-spacing:.14em;
  color:var(--muted);
}

#hud-status{
  display:flex;
  align-items:center;
  gap:8px;
  font-size:8px;
  letter-spacing:.16em;
  color:var(--muted);
}

.status-dot{
  width:6px;
  height:6px;
  border-radius:50%;
  background:#8ca8b9;
  box-shadow:0 0 7px rgba(150,200,230,.5);
}

.status-dot.live{
  background:#c9e7f5;
}

/* =========================================================
   CHAPTER BADGE
   ========================================================= */

#chapter-badge{
  position:absolute;
  top:86px;
  left:18px;
  z-index:15;

  display:flex;
  align-items:center;
  gap:11px;

  padding:7px 13px 8px 10px;

  border-left:2px solid var(--accent);
  background:rgba(2,7,15,.58);
  backdrop-filter:blur(5px);
  -webkit-backdrop-filter:blur(5px);

  pointer-events:none;
}

#chapter-no{
  font-family:
    "Roboto Mono",
    "SFMono-Regular",
    Consolas,
    monospace;
  font-size:9px;
  color:var(--accent);
  letter-spacing:.12em;
}

#chapter-copy{
  display:flex;
  flex-direction:column;
  gap:2px;
}

#chapter-title{
  font-size:14px;
  letter-spacing:.12em;
  color:var(--text);
}

#chapter-sub{
  font-size:8px;
  color:var(--muted);
  letter-spacing:.10em;
}

/* =========================================================
   CAMERA INFO
   ========================================================= */

#cam-info{
  position:absolute;
  top:86px;
  right:18px;
  z-index:15;

  display:flex;
  flex-direction:column;
  align-items:flex-end;
  gap:3px;

  pointer-events:none;
}

#cam-info .cam-label{
  font-family:
    "Roboto Mono",
    "SFMono-Regular",
    Consolas,
    monospace;
  font-size:8px;
  letter-spacing:.15em;
  color:var(--muted);
}

#cam-info .cam-name{
  font-size:9px;
  letter-spacing:.10em;
  color:var(--accent);
}

#cam-info .rec{
  display:flex;
  align-items:center;
  gap:5px;
  margin-top:2px;

  font-size:7px;
  letter-spacing:.12em;
  color:var(--dim);
}

#cam-info .rec-dot{
  width:5px;
  height:5px;
  border-radius:50%;
  background:var(--danger);
  box-shadow:0 0 6px rgba(223,109,100,.6);
  animation:recBlink 1.5s ease-in-out infinite;
}

@keyframes recBlink{
  0%,100%{opacity:.35}
  50%{opacity:1}
}

/* =========================================================
   TELEMETRY
   ========================================================= */

#telemetry{
  position:absolute;
  top:145px;
  right:18px;
  z-index:15;

  width:145px;

  padding:9px 10px;

  background:rgba(2,7,15,.56);
  border:1px solid rgba(145,190,220,.16);

  pointer-events:none;
}

#telemetry-title{
  margin-bottom:7px;

  font-size:7px;
  letter-spacing:.18em;
  color:var(--dim);
}

.telemetry-row{
  display:flex;
  justify-content:space-between;
  align-items:baseline;

  padding:3px 0;

  border-bottom:1px solid rgba(145,190,220,.07);
}

.telemetry-row:last-child{
  border-bottom:0;
}

.telemetry-row .t-k{
  font-family:
    "Roboto Mono",
    "SFMono-Regular",
    Consolas,
    monospace;
  font-size:7px;
  color:var(--muted);
  letter-spacing:.08em;
}

.telemetry-row .t-v{
  font-family:
    "Roboto Mono",
    "SFMono-Regular",
    Consolas,
    monospace;
  font-size:8px;
  color:var(--accent);
}

/* =========================================================
   CHRONOLOGY PANEL
   ========================================================= */

#chrono-panel{
  position:absolute;
  left:18px;
  top:145px;
  z-index:15;

  width:190px;

  padding:10px 11px;

  background:rgba(2,7,15,.50);
  border:1px solid rgba(145,190,220,.14);

  pointer-events:none;
}

#chrono-title{
  margin-bottom:8px;

  font-size:7px;
  letter-spacing:.18em;
  color:var(--dim);
}

.chrono-row{
  display:grid;
  grid-template-columns:45px 1fr;
  gap:8px;

  padding:4px 0;

  border-bottom:1px solid rgba(145,190,220,.06);
}

.chrono-row:last-child{
  border-bottom:0;
}

.chrono-time{
  font-family:
    "Roboto Mono",
    "SFMono-Regular",
    Consolas,
    monospace;
  font-size:7px;
  color:var(--muted);
}

.chrono-label{
  font-size:8px;
  color:#9fb1bd;
  line-height:1.4;
}

/* =========================================================
   DATA PANEL
   ========================================================= */

#data-panel{
  position:absolute;
  right:18px;
  bottom:150px;
  z-index:16;

  width:190px;

  padding:10px 11px;

  background:rgba(2,7,15,.68);
  border:1px solid rgba(145,190,220,.20);

  pointer-events:none;
}

#data-title{
  margin-bottom:8px;

  font-size:7px;
  letter-spacing:.18em;
  color:var(--dim);
}

.data-row{
  display:flex;
  justify-content:space-between;
  align-items:baseline;

  padding:3px 0;
}

.data-row .d-k{
  font-size:7px;
  color:var(--muted);
  letter-spacing:.06em;
}

.data-row .d-v{
  font-family:
    "Roboto Mono",
    "SFMono-Regular",
    Consolas,
    monospace;
  font-size:8px;
  color:var(--accent);
}

/* =========================================================
   TELOP
   ========================================================= */

#telop{
  position:absolute;
  left:50%;
  bottom:152px;
  z-index:18;

  width:min(760px,calc(100% - 40px));

  transform:translateX(-50%);

  text-align:center;

  pointer-events:none;
}

#telop-title{
  font-size:18px;
  font-weight:400;
  letter-spacing:.16em;
  color:#e6f0f5;

  text-shadow:
    0 1px 12px rgba(0,0,0,.8),
    0 0 20px rgba(100,150,190,.18);
}

#telop-sub{
  margin-top:7px;

  font-size:9px;
  line-height:1.7;
  letter-spacing:.12em;

  color:#9bb0be;
}

#subtitle{
  position:absolute;
  left:50%;
  bottom:91px;
  z-index:18;

  width:min(820px,calc(100% - 40px));

  transform:translateX(-50%);

  text-align:center;

  font-size:12px;
  line-height:1.8;
  letter-spacing:.06em;

  color:#d8e2e8;

  text-shadow:
    0 1px 10px #000,
    0 0 18px #000;

  pointer-events:none;
}

/* =========================================================
   IMPACT ALERT
   ========================================================= */

#impact-alert{
  position:absolute;
  left:50%;
  top:50%;
  z-index:40;

  transform:translate(-50%,-50%);

  pointer-events:none;
}

#impact-alert-box{
  padding:12px 20px;

  border:1px solid rgba(223,109,100,.58);
  background:rgba(30,5,5,.55);

  text-align:center;

  opacity:0;
}

#impact-alert .a-main{
  font-size:18px;
  letter-spacing:.22em;
  color:#e9aaa4;
}

#impact-alert .a-sub{
  margin-top:5px;

  font-family:
    "Roboto Mono",
    "SFMono-Regular",
    Consolas,
    monospace;

  font-size:8px;
  letter-spacing:.12em;
  color:#a46e6a;
}

#impact-alert-box.active{
  animation:impactAlert .7s ease-out both;
}

@keyframes impactAlert{
  0%{
    opacity:0;
    transform:scale(1.08);
  }
  20%{
    opacity:1;
    transform:scale(1);
  }
  70%{
    opacity:1;
  }
  100%{
    opacity:0;
  }
}

/* =========================================================
   BOTTOM HUD
   ========================================================= */

#hud-bottom{
  position:absolute;
  left:0;
  right:0;
  bottom:0;
  z-index:30;

  padding:
    0
    18px
    calc(12px + var(--safe-b));

  background:
    linear-gradient(
      to top,
      rgba(1,3,10,.95) 0%,
      rgba(1,3,10,.76) 48%,
      transparent 100%
    );

  pointer-events:auto;
}

/* =========================================================
   SEEK BAR
   ========================================================= */

#seek-wrap{
  width:100%;
  padding:12px 0 6px;
}

#seek{
  position:relative;

  width:100%;
  height:18px;

  cursor:pointer;
}

#seek-track{
  position:absolute;
  left:0;
  right:0;
  top:8px;

  height:2px;

  background:rgba(145,190,220,.22);
}

#seek-progress{
  position:absolute;
  left:0;
  top:8px;

  width:0;
  height:2px;

  background:var(--accent);

  box-shadow:0 0 7px rgba(155,199,227,.4);
}

#seek-marker{
  position:absolute;
  top:4px;

  width:9px;
  height:9px;

  margin-left:-4px;

  border:1px solid var(--accent);
  border-radius:50%;

  background:#07111a;

  box-shadow:
    0 0 8px rgba(155,199,227,.35);

  pointer-events:none;
}

#seek:hover #seek-track{
  background:rgba(145,190,220,.35);
}

#seek:hover #seek-marker{
  transform:scale(1.2);
}

/* =========================================================
   CONTROLS
   ========================================================= */

#controls{
  display:flex;
  align-items:center;

  width:100%;
  max-width:100%;
  min-width:0;

  gap:7px;

  overflow:hidden;
}

.ctl{
  display:flex;
  align-items:center;
  justify-content:center;

  width:36px;
  height:36px;

  flex:0 0 36px;

  padding:0;

  border:1px solid rgba(145,190,220,.20);
  border-radius:2px;

  background:rgba(6,14,24,.78);

  color:#a9bfcd;

  font-size:13px;
  line-height:1;

  cursor:pointer;

  transition:
    border-color .15s ease,
    background .15s ease,
    color .15s ease,
    transform .1s ease;
}

.ctl:hover{
  border-color:rgba(155,199,227,.48);
  background:rgba(15,28,40,.92);
  color:#e1edf3;
}

.ctl:active{
  transform:scale(.94);
}

.ctl.active{
  border-color:rgba(155,199,227,.58);
  color:var(--accent-2);
}

#btn-play{
  width:42px;
  height:42px;

  flex:0 0 42px;

  font-size:15px;

  border-color:rgba(155,199,227,.38);
}

#btn-speed{
  width:auto;
  min-width:36px;
  height:36px;

  flex:0 0 auto;

  padding:0 8px;

  font-family:
    "Roboto Mono",
    "SFMono-Regular",
    Consolas,
    monospace;

  font-size:10px;
  letter-spacing:.05em;
}

#ctl-spacer{
  flex:1 1 auto;
  min-width:0;
}

#time-code{
  flex:0 0 auto;

  min-width:0;

  margin-left:4px;

  font-family:
    "Roboto Mono",
    "SFMono-Regular",
    Consolas,
    monospace;

  font-size:10.5px;
  letter-spacing:.06em;

  color:#718695;

  white-space:nowrap;
}

/* =========================================================
   CONTROL HINT
   ========================================================= */

.ctl-hint{
  margin-left:4px;

  font-size:7px;
  letter-spacing:.12em;

  color:#536876;

  white-space:nowrap;
}

/* =========================================================
   CHAPTER MENU
   ========================================================= */

#chapter-menu{
  position:absolute;
  left:50%;
  bottom:80px;
  z-index:70;

  width:min(430px,calc(100% - 28px));
  max-height:min(65vh,500px);

  transform:translate(-50%,10px);

  padding:16px;

  overflow:auto;

  background:var(--panel-strong);
  border:1px solid var(--line-strong);

  box-shadow:
    0 20px 60px rgba(0,0,0,.55),
    inset 0 0 30px rgba(100,150,190,.025);

  opacity:0;
  visibility:hidden;

  pointer-events:none;

  transition:
    opacity .2s ease,
    transform .2s ease,
    visibility .2s ease;
}

#chapter-menu.open{
  opacity:1;
  visibility:visible;
  transform:translate(-50%,0);
  pointer-events:auto;
}

#chapter-menu-title{
  margin-bottom:11px;

  font-size:8px;
  letter-spacing:.18em;
  color:var(--dim);
}

.chapter-item{
  display:flex;
  align-items:center;

  gap:10px;

  width:100%;

  padding:11px;

  border:0;
  border-bottom:1px solid rgba(145,190,220,.08);

  background:transparent;

  text-align:left;

  cursor:pointer;
}

.chapter-item:last-child{
  border-bottom:0;
}

.chapter-item:hover{
  background:rgba(145,190,220,.055);
}

.chapter-item.active{
  background:rgba(145,190,220,.08);
}

.ci-no{
  flex:0 0 42px;

  font-family:
    "Roboto Mono",
    "SFMono-Regular",
    Consolas,
    monospace;

  font-size:9px;

  color:var(--accent);
}

.ci-copy{
  min-width:0;

  display:flex;
  flex-direction:column;

  gap:2px;
}

.ci-title{
  font-size:12px;
  color:#d4e0e7;
}

.ci-sub{
  font-size:8px;
  color:var(--muted);
}

.ci-time{
  margin-left:auto;

  font-family:
    "Roboto Mono",
    "SFMono-Regular",
    Consolas,
    monospace;

  font-size:10px;

  color:#637886;
}

/* =========================================================
   INTRO
   ========================================================= */

#intro{
  position:absolute;
  inset:0;
  z-index:90;

  display:flex;
  align-items:center;
  justify-content:center;

  background:
    radial-gradient(
      ellipse at center,
      rgba(5,16,28,.72),
      rgba(1,3,10,.97) 78%
    );

  transition:
    opacity .7s ease,
    visibility .7s ease;
}

#intro.hidden{
  opacity:0;
  visibility:hidden;
  pointer-events:none;
}

#intro-inner{
  width:min(720px,calc(100% - 40px));

  text-align:center;
}

#intro-mark{
  position:relative;

  width:56px;
  height:56px;

  margin:0 auto 20px;

  border:1px solid rgba(155,199,227,.40);

  transform:rotate(45deg);
}

#intro-mark::before,
#intro-mark::after{
  content:"";

  position:absolute;

  background:var(--accent);
}

#intro-mark::before{
  left:50%;
  top:8px;
  bottom:8px;
  width:1px;
  transform:translateX(-50%);
}

#intro-mark::after{
  top:50%;
  left:8px;
  right:8px;
  height:1px;
  transform:translateY(-50%);
}

#intro-kicker{
  margin-bottom:11px;

  font-size:8px;
  letter-spacing:.26em;

  color:var(--accent);
}

#intro-title{
  margin:0;

  font-size:clamp(24px,4vw,42px);
  font-weight:300;
  letter-spacing:.14em;

  color:#e5eef3;
}

#intro-subtitle{
  margin-top:9px;

  font-size:10px;
  letter-spacing:.18em;

  color:#7890a3;
}

#intro-rule{
  width:100px;
  height:1px;

  margin:22px auto;

  background:rgba(155,199,227,.28);
}

#intro .i-lead{
  max-width:600px;

  margin:0 auto;

  font-size:12px;
  line-height:2;

  letter-spacing:.06em;

  color:#9fb1bd;
}

#btn-start{
  margin-top:28px;

  padding:13px 32px;

  border:1px solid rgba(155,199,227,.40);
  border-radius:2px;

  background:rgba(8,18,29,.75);

  font-size:14px;
  letter-spacing:.16em;

  color:#cfe3ed;

  cursor:pointer;

  transition:
    background .2s ease,
    border-color .2s ease,
    transform .1s ease;
}

#btn-start:hover{
  background:rgba(19,37,51,.92);
  border-color:rgba(155,199,227,.68);
}

#btn-start:active{
  transform:scale(.97);
}

/* =========================================================
   END CARD
   ========================================================= */

#end-card{
  position:absolute;
  inset:0;
  z-index:85;

  display:flex;
  align-items:center;
  justify-content:center;

  background:
    radial-gradient(
      ellipse at center,
      rgba(4,12,21,.72),
      rgba(1,3,10,.98)
    );

  opacity:0;
  visibility:hidden;
  pointer-events:none;

  transition:
    opacity .8s ease,
    visibility .8s ease;
}

#end-card.visible{
  opacity:1;
  visibility:visible;
  pointer-events:auto;
}

#end-inner{
  width:min(700px,calc(100% - 40px));

  text-align:center;
}

#end-card .e-kicker{
  font-size:8px;
  letter-spacing:.22em;
  color:var(--accent);
}

#end-card .e-title{
  margin-top:12px;

  font-size:clamp(25px,5vw,44px);
  font-weight:300;
  letter-spacing:.16em;

  color:#e5eef3;
}

#end-card .e-quote{
  margin-top:25px;

  font-size:11.5px;
  line-height:1.8;

  letter-spacing:.06em;

  color:#9fb1bd;
}

#end-card .e-credit{
  margin-top:30px;

  font-size:8px;
  letter-spacing:.12em;

  color:#566b78;
}

#btn-restart{
  margin-top:24px;

  padding:11px 25px;

  border:1px solid rgba(145,190,220,.28);
  background:rgba(6,14,24,.72);

  font-size:10px;
  letter-spacing:.14em;

  color:#a9bfcd;

  cursor:pointer;
}

/* =========================================================
   DAMAGE LIST
   ========================================================= */

#damage-list{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:8px;

  margin-top:15px;

  padding:0;

  list-style:none;
}

#damage-list li{
  padding:9px;

  border:1px solid rgba(145,190,220,.12);

  background:rgba(5,12,20,.46);

  text-align:center;
}

#damage-list .d-k{
  display:block;

  font-size:7px;
  color:var(--muted);

  letter-spacing:.08em;
}

#damage-list .d-v{
  display:block;

  margin-top:3px;

  font-family:
    "Roboto Mono",
    "SFMono-Regular",
    Consolas,
    monospace;

  font-size:17px;

  color:#c8dbe4;
}

/* =========================================================
   LOADER
   ========================================================= */

#loader{
  position:absolute;
  inset:0;
  z-index:200;

  display:flex;
  align-items:center;
  justify-content:center;

  background:#01030a;

  transition:
    opacity .5s ease,
    visibility .5s ease;
}

#loader.hidden{
  opacity:0;
  visibility:hidden;
  pointer-events:none;
}

#loader-inner{
  text-align:center;
}

#loader-mark{
  width:30px;
  height:30px;

  margin:0 auto 16px;

  border:1px solid rgba(155,199,227,.25);
  border-top-color:var(--accent);
  border-radius:50%;

  animation:loaderSpin 1s linear infinite;
}

@keyframes loaderSpin{
  to{
    transform:rotate(360deg);
  }
}

#loader-text{
  font-family:
    "Roboto Mono",
    "SFMono-Regular",
    Consolas,
    monospace;

  font-size:8px;
  letter-spacing:.18em;

  color:#657b89;
}

/* =========================================================
   STAT BAR
   ========================================================= */

#stat-bar{
  position:absolute;
  left:50%;
  top:18px;
  z-index:25;

  transform:translateX(-50%);

  display:flex;
  align-items:center;
  gap:7px;

  padding:5px 9px;

  border:1px solid rgba(145,190,220,.15);
  background:rgba(2,7,15,.45);

  pointer-events:none;
}

#stat-bar .stat-label{
  font-size:7px;
  letter-spacing:.12em;
  color:var(--muted);
}

#stat-bar .stat-value{
  font-family:
    "Roboto Mono",
    "SFMono-Regular",
    Consolas,
    monospace;

  font-size:8px;
  color:var(--accent);
}

#stat-bar.critical{
  border-color:rgba(223,109,100,.38);
  animation:criticalPulse 1s ease-in-out infinite;
}

@keyframes criticalPulse{
  0%,100%{opacity:.65}
  50%{opacity:1}
}

